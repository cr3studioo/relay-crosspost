# Dashboard: copy to .env.local. Never commit the filled file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=
APP_URL=http://localhost:3000
# Generate once: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Use the SAME 64-character hex key in Vercel and the worker.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Set when using a Facebook Login for Business configuration.
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0
